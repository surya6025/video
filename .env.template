# JarvisX Configuration
# Copy this file to .env and fill in your values

# Supabase Configuration (Required for persistent memory)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Ollama Configuration (Local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional Cloud LLM (if not using Ollama)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Remote Update Configuration
REMOTE_UPDATE_URL=https://github.com/yourusername/jarvisx-updates
REMOTE_UPDATE_BRANCH=main

# Security Settings
ALLOW_DANGEROUS_DEFAULT=false
PERMISSION_TIMEOUT=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/jarvisx.log

# Temporary Directory
TEMP_DIR=temp
LOGS_DIR=logs

# Feature Flags
ENABLE_WEB_SEARCH=true
ENABLE_SYSTEM_CONTROL=true
ENABLE_CYBERSECURITY=true
ENABLE_AUTOMATION=true